# ================================================================
# BVAR: ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ
# ================================================================

create_var_lags <- function(y, p) {
  T <- nrow(y); N <- ncol(y)
  Y <- y[(p+1):T, , drop=FALSE]
  X <- matrix(0, T-p, N*p)
  for (i in 1:p) X[, ((i-1)*N+1):(i*N)] <- y[(p+1-i):(T-i), ]
  X <- cbind(X, 1)
  list(Y=Y, X=X)
}

setup_minnesota_prior <- function(y, p, lambda=0.2, alpha=2, var_scale=1) {
  N <- ncol(y); K <- N*p + 1
  phi_ar1 <- numeric(N); sigma <- numeric(N)
  for (i in 1:N) {
    y_i <- na.omit(y[, i])
    if (length(y_i) <= 2) {
      phi_ar1[i] <- 0.9; sigma[i] <- sd(y_i, na.rm=TRUE)
    } else {
      y_lag <- y_i[-length(y_i)]; y_lead <- y_i[-1]
      X_ar  <- cbind(1, y_lag)
      beta_ar    <- solve(t(X_ar) %*% X_ar) %*% t(X_ar) %*% y_lead
      phi_ar1[i] <- beta_ar[2]
      sigma[i]   <- sqrt(sum((y_lead - X_ar %*% beta_ar)^2) / (length(y_lead)-2))
    }
  }
  B_prior <- matrix(0, K, N)
  for (i in 1:N) B_prior[i, i] <- phi_ar1[i]
  V_prior_list <- vector("list", N)
  for (eq in 1:N) {
    V_eq <- matrix(0, K, K)
    for (j in 1:N) for (l in 1:p) {
      idx <- (l-1)*N + j
      V_eq[idx, idx] <- if (eq==j) (lambda^2)/(l^(2*alpha))
      else (lambda^2)*(sigma[eq]^2)/((l^(2*alpha))*(sigma[j]^2))
    }
    V_eq[K, K] <- 100
    V_prior_list[[eq]] <- V_eq
  }
  list(B_prior=B_prior, V_prior_list=V_prior_list,
       S_prior=diag(sigma^2)*var_scale, nu_prior=N+2,
       sigma=sigma, phi_ar1=phi_ar1)
}

gibbs_bvar <- function(Y, X, prior, n_draws=5000, n_burn=1000) {
  N <- ncol(Y); K <- ncol(X); T_obs <- nrow(Y)
  B_draws     <- array(0, dim=c(K, N, n_draws))
  Sigma_draws <- array(0, dim=c(N, N, n_draws))
  B     <- solve(t(X) %*% X + diag(0.01, K)) %*% t(X) %*% Y
  Sigma <- diag(diag(cov(Y - X %*% B)))
  V_prior_inv_list <- lapply(prior$V_prior_list, function(V) solve(V + diag(1e-6, K)))
  XtX <- t(X) %*% X
  cat("Running Gibbs sampler...\n")
  pb <- txtProgressBar(min=0, max=n_draws+n_burn, style=3)
  for (iter in 1:(n_draws+n_burn)) {
    for (j in 1:N) {
      V_prior_inv_j <- V_prior_inv_list[[j]]
      V_post <- solve(V_prior_inv_j + (1/Sigma[j,j])*XtX)
      V_post <- (V_post + t(V_post))/2
      B_post <- V_post %*% (V_prior_inv_j %*% prior$B_prior[,j] + (1/Sigma[j,j])*t(X) %*% Y[,j])
      B[,j]  <- B_post + t(chol(V_post)) %*% rnorm(K)
    }
    resid   <- Y - X %*% B
    S_post  <- prior$S_prior + t(resid) %*% resid
    nu_post <- prior$nu_prior + T_obs
    Sigma   <- solve(rWishart(1, nu_post, solve(S_post))[,,1])
    if (iter > n_burn) {
      B_draws[,,iter-n_burn]     <- B
      Sigma_draws[,,iter-n_burn] <- Sigma
    }
    setTxtProgressBar(pb, iter)
  }
  close(pb)
  list(B_draws=B_draws, Sigma_draws=Sigma_draws)
}

