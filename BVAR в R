forecast_bvar_multistep <- function(bvar_train, train_y, n_lags, forecast_horizon, target_col_idx) {
  N  <- ncol(train_y); nd <- dim(bvar_train$B_draws)[3]; te <- nrow(train_y)
  fc_draws <- matrix(0, forecast_horizon, nd)
  for (d in 1:nd) {
    B_draw <- bvar_train$B_draws[,,d]
    y_lag  <- train_y[te:(te-n_lags+1), , drop=FALSE]
    state  <- as.vector(t(y_lag))
    for (h in 1:forecast_horizon) {
      y_next        <- as.vector(c(state,1) %*% B_draw)
      fc_draws[h,d] <- y_next[target_col_idx]
      state <- if (n_lags>1) c(y_next, state[1:(N*(n_lags-1))]) else y_next
    }
  }
  fc_draws
}

cat("\n### Rolling BVAR GDP forecast (OOS evaluation) ###\n")
bvar_oos <- list()

for (fh in horizons) {
  cat(sprintf("\n  Horizon h=%d\n", fh))
  errors <- c()
  ft <- data.frame(date=as.Date(character()), actual=numeric(),
                   forecast=numeric(), lower80=numeric(), upper80=numeric())
  for (t in start_idx:(nrow(y_data)-fh)) {
    if (t < min_obs) next
    train_y  <- y_data[1:t, , drop=FALSE]
    vd       <- create_var_lags(train_y, n_lags)
    if (nrow(vd$Y) < n_lags+10) next
    prior_t  <- setup_minnesota_prior(train_y, n_lags, lambda, alpha)
    bvar_t   <- gibbs_bvar(vd$Y, vd$X, prior_t, n_draws=2000, n_burn=500)
    fc_draws <- forecast_bvar_multistep(bvar_t, train_y, n_lags, fh, gdp_idx)
    fc_h     <- fc_draws[fh, ]
    actual_val <- y_data[t+fh, gdp_idx]; if (is.na(actual_val)) next
    errors <- c(errors, actual_val - mean(fc_h))
    ft <- rbind(ft, data.frame(
      date     = as.Date(as.yearmon(forecast_dates[t+fh])),
      actual   = actual_val,
      forecast = mean(fc_h),
      lower80  = quantile(fc_h, 0.10),
      upper80  = quantile(fc_h, 0.90)
    ))
  }
  rmse <- sqrt(mean(errors^2, na.rm=TRUE))
  mae  <- mean(abs(errors),   na.rm=TRUE)
  bvar_oos[[paste0("h",fh)]] <- list(table=ft, errors=errors, rmse=rmse, mae=mae)
  cat(sprintf("  RMSE=%.6f  MAE=%.6f  N=%d\n", rmse, mae, length(errors)))
}

