compute_irf_bvar <- function(B_draws, Sigma_draws, n_periods=12, conf_level=0.68) {
  K <- dim(B_draws)[1]; N <- dim(B_draws)[2]; n_dr <- dim(B_draws)[3]
  p <- (K-1)/N
  irf_draws <- array(0, dim=c(N,N,n_periods,n_dr))
  cat("\nComputing IRFs...\n"); pb <- txtProgressBar(0, n_dr, style=3)
  for (d in 1:n_dr) {
    B <- B_draws[,,d]; Sigma <- Sigma_draws[,,d]
    P <- t(chol(Sigma)); A <- B[1:(N*p), ]
    comp <- if (p>1) rbind(t(A), cbind(diag(N*(p-1)), matrix(0,N*(p-1),N))) else t(A)
    pwr  <- diag(nrow(comp))
    for (h in 1:n_periods) {
      if (h>1) pwr <- pwr %*% comp
      irf_draws[,,h,d] <- pwr[1:N,1:N] %*% P
    }
    setTxtProgressBar(pb, d)
  }
  close(pb)
  list(mean  = apply(irf_draws, c(1,2,3), mean),
       lower = apply(irf_draws, c(1,2,3), quantile, probs=(1-conf_level)/2),
       upper = apply(irf_draws, c(1,2,3), quantile, probs=1-(1-conf_level)/2),
       draws = irf_draws)
}

