    shock_name <- var_norm_names[var_names[shock_idx]]
    pd <- data.frame(period=0:(n_periods-1),
                     mean  =irf_results$mean[target_idx,shock_idx,],
                     lower =irf_results$lower[target_idx,shock_idx,],
                     upper =irf_results$upper[target_idx,shock_idx,])
    plot_list[[length(plot_list)+1]] <- ggplot(pd, aes(x=period)) +
      geom_ribbon(aes(ymin=lower,ymax=upper), alpha=0.3, fill="lightblue") +
      geom_line(aes(y=mean), color="blue", linewidth=1) +
      geom_hline(yintercept=0, color="black", alpha=0.4) +
      labs(title=paste(target_name,"→",shock_name), x="Periods", y="Response") +
      theme_minimal() + theme(plot.title=element_text(face="bold",size=10))
  }
  do.call(gridExtra::grid.arrange, c(plot_list, ncol=4,
                                     top=paste("IRFs:", target_name, "Response")))
}

