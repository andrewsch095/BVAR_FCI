  fdate <- last_date + fh/12
  
  cat(sprintf("\n--- Прогноз на %d месяцев вперёд (дата: %s) ---\n",
              fh, format(fdate, "%Y-%m")))
  cat(sprintf("  Медиана:           %+.4f%%\n", median(fc)*100))
  cat(sprintf("  Среднее:           %+.4f%%\n", mean(fc)*100))
  cat(sprintf("  80%% ДИ:  [%+.4f%% ; %+.4f%%]\n",
              quantile(fc,0.10)*100, quantile(fc,0.90)*100))
  cat(sprintf("  90%% ДИ:  [%+.4f%% ; %+.4f%%]\n",
              quantile(fc,0.05)*100, quantile(fc,0.95)*100))
}

# ---- График путей прогноза (fan chart) ----

# Собираем все пути на 6 шагов вперёд (покрывает оба горизонта)
max_fh     <- max(horizons_future)
all_paths  <- matrix(0, max_fh, n_draws)
for (d in 1:n_draws) {
  B_draw <- bvar_results$B_draws[,,d]
  y_lag  <- y_data[te:(te-n_lags+1), , drop=FALSE]
  state  <- as.vector(t(y_lag))
  for (h in 1:max_fh) {
    y_next        <- as.vector(c(state,1) %*% B_draw)
    all_paths[h,d] <- y_next[gdp_idx]
    state <- if (n_lags>1) c(y_next, state[1:(N_full*(n_lags-1))]) else y_next
  }
}

# Таблица с квантилями по шагам
future_dates <- last_date + (1:max_fh)/12
fan_df <- data.frame(
  date   = as.Date(future_dates),
  med    = apply(all_paths, 1, median),
  mean   = apply(all_paths, 1, mean),
  lo90   = apply(all_paths, 1, quantile, 0.05),
  hi90   = apply(all_paths, 1, quantile, 0.95),
  lo80   = apply(all_paths, 1, quantile, 0.10),
  hi80   = apply(all_paths, 1, quantile, 0.90),
  lo50   = apply(all_paths, 1, quantile, 0.25),
  hi50   = apply(all_paths, 1, quantile, 0.75)
)

# Исторические данные (последние 24 наблюдения для контекста)
n_hist   <- 24
hist_idx <- max(1, te - n_hist + 1):te
hist_df  <- data.frame(
  date = as.Date(forecast_dates[hist_idx]),
  gdp  = y_data[hist_idx, gdp_idx]
)

p_fan <- ggplot() +
  # Исторические данные
  geom_line(data=hist_df, aes(x=date, y=gdp*100, color="Фактический ВВП"), linewidth=1) +
  # Fan chart: 90% ДИ
  geom_ribbon(data=fan_df, aes(x=date, ymin=lo90*100, ymax=hi90*100),
              fill="#2171b5", alpha=0.15) +
  # Fan chart: 80% ДИ
  geom_ribbon(data=fan_df, aes(x=date, ymin=lo80*100, ymax=hi80*100),
              fill="#2171b5", alpha=0.20) +
  # Fan chart: 50% ДИ
  geom_ribbon(data=fan_df, aes(x=date, ymin=lo50*100, ymax=hi50*100),
              fill="#2171b5", alpha=0.25) +
  # Медианный прогноз
  geom_line(data=fan_df, aes(x=date, y=med*100, color="Медиана прогноза"),
            linewidth=1.2, linetype="dashed") +
  # Точки горизонтов h=3 и h=6
  geom_point(data=fan_df[fan_df$date %in% as.Date(future_dates[horizons_future]), ],
             aes(x=date, y=med*100), color="red", size=3) +
  geom_vline(xintercept=as.Date(last_date), linetype="dotted", color="grey40") +
  scale_color_manual(values=c("Фактический ВВП"="black","Медиана прогноза"="blue")) +
  labs(title = "BVAR: Прогноз ВВП на 3 и 6 месяцев вперёд",
       subtitle = sprintf("Дата последнего наблюдения: %s", format(last_date,"%Y-%m")),
       x = "Дата", y = "ВВП м/м, %", color = "",
       caption = "Заливка: 50% / 80% / 90% доверительные интервалы") +
  theme_minimal() +
  theme(plot.title    = element_text(face="bold", size=13),
        plot.subtitle = element_text(size=10),
        legend.position = "bottom")

print(p_fan)

