compute_fevd <- function(irf_results, n_periods=12) {
  irf_mean <- irf_results$mean; N <- dim(irf_mean)[1]
  fevd <- array(0, dim=c(N,N,n_periods))
  for (h in 1:n_periods) for (resp in 1:N) {
    total_var <- sum(irf_mean[resp,,1:h]^2)
    for (shock in 1:N)
      fevd[resp,shock,h] <- sum(irf_mean[resp,shock,1:h]^2)/total_var*100
  }
  fevd
}

